[Unit]
Description=Nekomari deploy-verification agent (test instance on :25775)
Documentation=https://github.com/Aone2233/Nekomari
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/nekomari-testctl
ExecStart=%h/nekomari-testctl/komari-agent-linux-amd64 \
  -e http://127.0.0.1:25775 \
  -t GxvqjOvfdGLun6Iv3tPVc1 \
  -i 3 \
  --disable-auto-update \
  --disable-web-ssh
Restart=always
RestartSec=5

# 探针只需要读 /proc /sys 做基础信息采集；显式收敛写权限。
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/nekomari-testctl
PrivateTmp=yes

[Install]
WantedBy=default.target
