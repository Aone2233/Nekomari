index 0000000..8dfafae
--- /dev/null
+++ b/src/utils/pingChartIdentity.ts
@@ -0,0 +1,52 @@
+export interface PingDimensions {
+  taskId: string | number
+  family?: string
+  protocol?: string
+  role?: string
+}
+
+export function showPingRole(role: string | undefined, showReference: boolean): boolean {
+  return role !== 'reference' || showReference
+}
+
+export function showPingSeries(role: string | undefined, protocol: string | undefined, taskType: string | undefined, showReference: boolean): boolean {
+  if (!showPingRole(role, showReference))
+    return false
+  // A reference can intentionally use a different protocol from its main target.
+  if (role === 'reference' || (role && role !== 'primary'))
+    return true
+  const singleProtocols = ['icmp', 'tcp', 'http']
+  if (!taskType || !protocol || !singleProtocols.includes(taskType) || !singleProtocols.includes(protocol))
+    return true
+  return taskType === protocol
+}
+
+export function currentPingTaskTypes(stats: { task_id: string, type?: string }[]): Map<string, string> {
+  const types = new Map<string, string>()
+  for (const stat of stats) {
+    const taskId = Number(stat.task_id)
+    if (!Number.isInteger(taskId) || taskId <= 0 || !stat.type)
+      continue
+    const id = String(taskId)
+    const previous = types.get(id)
+    types.set(id, previous === undefined || previous === stat.type ? stat.type : '')
+  }
+  return types
+}
+
+export function pingSeriesId(dimensions: PingDimensions): string {
+  return JSON.stringify([
+    String(dimensions.taskId),
+    dimensions.family ?? '',
+    dimensions.protocol ?? '',
+    dimensions.role ?? '',
+  ])
+}
+
+export function pingSeriesLabel(name: string, dimensions: PingDimensions): string {
+  const details = [dimensions.family?.toUpperCase() || '族未知', dimensions.protocol?.toUpperCase() || '协议未知']
+  // Nekomari's legacy wire format omits the role for the primary target.
+  // Keep IDs distinct; only the user-facing meaning of an empty role changes.
+  details.push(dimensions.role === 'reference' ? '参考点' : !dimensions.role || dimensions.role === 'primary' ? '主目标' : `未知角色: ${dimensions.role}`)
+  return `${name} (${details.join(' / ')})`
+}
