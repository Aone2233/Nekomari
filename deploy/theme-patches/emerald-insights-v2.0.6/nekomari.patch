diff --git a/tests/utils/ping-chart-identity.test.ts b/tests/utils/ping-chart-identity.test.ts
new file mode 100644
index 0000000..38d8033
--- /dev/null
+++ b/tests/utils/ping-chart-identity.test.ts
@@ -0,0 +1,80 @@
+import assert from 'node:assert/strict'
+// eslint-disable-next-line test/no-import-node-test -- This repository uses Node's test runner.
+import { it } from 'node:test'
+import { currentPingTaskTypes, pingSeriesId, pingSeriesLabel, showPingRole, showPingSeries } from '../../src/utils/pingChartIdentity'
+import { createPingSeries, smoothPingChartRows } from '../../src/utils/pingChartSeries'
+
+it('keeps task, family, protocol and reference dimensions distinct without delimiter collisions', () => {
+  const base = { taskId: 28, family: 'ipv6', protocol: 'icmp' }
+  const ids = [
+    pingSeriesId(base),
+    pingSeriesId({ ...base, role: 'reference' }),
+    pingSeriesId({ ...base, protocol: 'tcp' }),
+    pingSeriesId({ ...base, family: 'ipv4' }),
+    pingSeriesId({ ...base, family: '' }),
+    pingSeriesId({ taskId: '28", "ipv6', family: 'icmp' }),
+  ]
+  assert.equal(new Set(ids).size, ids.length)
+  assert.equal(pingSeriesId({ taskId: 28 }), pingSeriesId({ taskId: '28', family: '', protocol: '', role: '' }))
+  assert.match(pingSeriesLabel('Example', { ...base, role: 'reference' }), /IPV6 \/ ICMP \/ 参考点/)
+  assert.match(pingSeriesLabel('Example', { taskId: 28 }), /族未知 \/ 协议未知 \/ 主目标/)
+  assert.match(pingSeriesLabel('Example', { ...base, role: 'primary' }), /主目标/)
+  assert.match(pingSeriesLabel('Example', { ...base, role: 'future' }), /未知角色: future/)
+  assert.notEqual(pingSeriesId(base), pingSeriesId({ ...base, role: 'primary' }))
+})
+
+it('hides only reference measurements by default and allows explicit opt-in', () => {
+  assert.equal(showPingRole('reference', false), false)
+  assert.equal(showPingRole('reference', true), true)
+  assert.equal(showPingRole(undefined, false), true)
+  assert.equal(showPingRole('primary', false), true)
+  assert.equal(showPingRole('future', false), true)
+})
+
+it('hides only known retired primary protocols for single-protocol tasks', () => {
+  assert.equal(showPingSeries('', 'icmp', 'icmp', false), true)
+  assert.equal(showPingSeries('primary', 'tcp', 'icmp', false), false)
+  assert.equal(showPingSeries('', 'icmp', 'tcp', false), false)
+  assert.equal(showPingSeries('', 'tcp', 'http', false), false)
+  assert.equal(showPingSeries('', 'tcp', 'dual', false), true)
+  assert.equal(showPingSeries('', 'tcp', 'auto', false), true)
+  assert.equal(showPingSeries('', '', 'icmp', false), true)
+  assert.equal(showPingSeries('', 'future', 'icmp', false), true)
+  assert.equal(showPingSeries('', 'tcp', undefined, false), true)
+  assert.equal(showPingSeries('future', 'tcp', 'icmp', false), true)
+  assert.equal(showPingSeries('reference', 'icmp', 'tcp', false), false)
+  assert.equal(showPingSeries('reference', 'icmp', 'tcp', true), true)
+})
+
+it('uses an unambiguous current task type and preserves conflicting data', () => {
+  const types = currentPingTaskTypes([
+    { task_id: '28', type: 'icmp' },
+    { task_id: '28', type: 'icmp' },
+    { task_id: '30', type: 'dual' },
+    { task_id: '30', type: 'tcp' },
+    { task_id: '30', type: 'tcp' },
+    { task_id: '0', type: 'tcp' },
+    { task_id: 'not-a-number', type: 'tcp' },
+    { task_id: '31' },
+  ])
+  assert.equal(types.get('28'), 'icmp')
+  assert.equal(types.get('30'), '')
+  assert.equal(types.has('0'), false)
+  assert.equal(types.has('31'), false)
+  assert.equal(showPingSeries('', 'tcp', types.get('30'), false), true)
+})
+
+it('draws and smooths keyed groups separately', () => {
+  const first = pingSeriesId({ taskId: 28, family: 'ipv6', protocol: 'icmp' })
+  const second = pingSeriesId({ taskId: 28, family: 'ipv6', protocol: 'icmp', role: 'reference' })
+  const rows = [
+    { time: '2026-11-01T00:00:00Z', [first]: 40, [second]: 200 },
+    { time: '2026-11-01T00:01:00Z', [first]: 50, [second]: 210 },
+  ]
+  const tasks = [{ id: first, name: 'primary', interval: 60 }, { id: second, name: 'reference', interval: 60 }]
+  const smoothed = smoothPingChartRows(rows, tasks, 1)
+  assert.equal(createPingSeries(rows, tasks[0]!, 1, 'red', true, false)[0]!.data[0]![1], 40)
+  assert.equal(createPingSeries(rows, tasks[1]!, 1, 'blue', true, false)[0]!.data[0]![1], 200)
+  assert.equal(smoothed[1]![first], 43)
+  assert.equal(smoothed[1]![second], 203)
+})
