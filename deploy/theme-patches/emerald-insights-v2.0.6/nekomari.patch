diff --git a/src/utils/pingChartIdentity.ts b/src/utils/pingChartIdentity.ts
new file mode 100644
index 0000000..869bc0d
--- /dev/null
+++ b/src/utils/pingChartIdentity.ts
@@ -0,0 +1,21 @@
+export interface PingDimensions {
+  taskId: string | number
+  family?: string
+  protocol?: string
+  role?: string
+}
+
+export function pingSeriesId(dimensions: PingDimensions): string {
+  return JSON.stringify([
+    String(dimensions.taskId),
+    dimensions.family ?? '',
+    dimensions.protocol ?? '',
+    dimensions.role ?? '',
+  ])
+}
+
+export function pingSeriesLabel(name: string, dimensions: PingDimensions): string {
+  const details = [dimensions.family?.toUpperCase() || '族未知', dimensions.protocol?.toUpperCase() || '协议未知']
+  details.push(dimensions.role === 'reference' ? '参考' : dimensions.role === 'primary' ? '主目标' : dimensions.role || '角色未标记')
+  return `${name} (${details.join(' / ')})`
+}
diff --git a/tests/utils/ping-chart-identity.test.ts b/tests/utils/ping-chart-identity.test.ts
