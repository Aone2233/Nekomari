-/** /api/records/ping?hours=N — global ping records across all nodes & tasks */
+/** Per-node ping history merged into the legacy PingHistory shape. */
+export async function fetchPingHistoryForNodes(
+  nodes: Array<{ uuid: string }>,
+  hours = 1,
+): Promise<PingHistory> {
+  const tasks = new Map<number, PingTask>()
+  const records: PingRecord[] = []
+  let next = 0
+  const workers = Array.from({ length: Math.min(6, nodes.length) }, async () => {
+    while (next < nodes.length) {
+      const node = nodes[next++]
+      const history = await fetchNodePingHistory(node.uuid, hours)
+      for (const task of history.tasks) tasks.set(task.id, task)
+      for (const record of history.records) {
+        records.push({ ...record, client: record.client || node.uuid })
+      }
+    }
+  })
+  await Promise.all(workers)
+  return { count: records.length, tasks: [...tasks.values()], records }
+}
+
+/** /api/records/ping?hours=N — kept for callers that still want the legacy shape. */
