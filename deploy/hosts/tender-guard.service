[Unit]
Description=Komari Agent (Nekomari)
Documentation=https://github.com/Aone2233/Nekomari
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=komari
Group=komari
WorkingDirectory=/opt/komari

# The NOSLA Tokyo node, added 2026-09-20. It was first enrolled with
# --auto-discovery, because the panel's install dialog was still handing out
# upstream's installer (see the note in frontend/src/pages/admin/index.tsx); it now
# carries its own node token like every other node.
#
# Why that switch matters: auto-discovery registers a *new* client every time it
# starts without a saved token -- web/api/client/autoDiscovery.go calls
# CreateClientWithName unconditionally -- so the node's identity depended on
# /opt/komari/auto-discovery.json surviving. The file is left in place, but it is
# ignored without the flag.
#
# The token is a credential: it is replaced by a placeholder here, the same rule as
# the other units (see docs/SECRETS.md).
#
# The binary path is /opt/komari/agent, not the /opt/nekomari-agent/... the other
# nodes use; the installer script must not assume a single layout.
#
# --month-rotate is the node's billing day, not a fleet constant: the live fleet runs
# HNJP01=18, HK04=11, AKKO06=12, megabox=7, CLISP=11, each matching its own
# expired_at day (see deploy/set-month-rotate.sh). NOSLA renews on the 20th, so 20.
# Without the flag the agent reports the raw kernel counter since boot and the panel
# divides it by the plan limit; with it, the agent sums the per-interval deltas that
# netstatic records inside the cycle window. netstatic only runs when the flag is set
# (agent/cmd/root.go), which is why this node had no net_static.json until the flag
# was added.
#
# The hardening block below is what the installed unit carries. Note that
# NoNewPrivileges=yes and PrivateTmp=yes each defeat a *file* capability, which is
# why this unit grants CAP_NET_RAW through AmbientCapabilities instead -- the same
# trap documented in deploy/README.md for MAC-WAN.
ExecStart=/opt/komari/agent \
  -e https://komari.orderly2233.org \
  -t <AGENT_TOKEN> \
  -i 5 \
  --info-report-interval 10 \
  --exclude-nics lo,docker0 \
  --month-rotate 20 \
  --disable-auto-update

Restart=always
RestartSec=5

# ---- 安全加固（最小权限）----
NoNewPrivileges=yes
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
ProtectSystem=strict
ReadWritePaths=/opt/komari
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
