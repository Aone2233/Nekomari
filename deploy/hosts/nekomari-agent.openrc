#!/sbin/openrc-run
# Nekomari agent as an OpenRC service (Alpine and other non-systemd hosts).
#
# The bundled installer is systemd-only, so this is the OpenRC equivalent: the
# binary plus the flags from /etc/conf.d/nekomari-agent, supervised so it comes
# back after a crash or a network blip. Host-specific settings live in that conf.d
# file (mode 0600) rather than here.
#
# The token is NOT one of them: it goes in a credential file and reaches the agent
# as `--token-file`. Putting it in conf.d only protects it at rest, because this
# script interpolates whatever it reads into `command_args` -- and a command line
# is readable by every local user through /proc/<pid>/cmdline. JPKD2 ran that way
# until 2026-09-26; docs/SECRETS.md (incident 5) has the record.
#
#   umask 077; printf 'AGENT_TOKEN=%s\n' '<token from the panel>' \
#     > /opt/nekomari-agent/.agent-credentials

name="Nekomari monitoring agent"
description="Reports this host to the Nekomari panel"

command="/opt/nekomari-agent/komari-agent"
command_args="-e ${NEKOMARI_ENDPOINT} --token-file ${NEKOMARI_TOKEN_FILE} ${NEKOMARI_EXTRA_ARGS}"
command_user="root"
pidfile="/run/${RC_SVCNAME}.pid"

# The agent writes its traffic ledger (net_static.json) relative to its working
# directory. Without this it lands in whatever directory supervise-daemon happens
# to start from -- and a ledger at "/" is both hard to find and easy to lose.
directory="/opt/nekomari-agent"

# supervise-daemon instead of start-stop-daemon --background, so the agent is
# restarted on exit rather than left down until someone notices.
supervisor="supervise-daemon"
respawn_delay=5
respawn_max=0

output_log="/var/log/nekomari-agent.log"
error_log="/var/log/nekomari-agent.log"

depend() {
	need net
	after firewall
}
