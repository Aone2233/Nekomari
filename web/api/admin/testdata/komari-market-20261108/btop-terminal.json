{
  "name": "btop++ 极客终端",
  "short": "btop-terminal",
  "description": "真实还原 Linux 顶级终端监控工具 btop++ 的硬核字符与色块风格，高刷新率、多节点聚合看板与终端沉浸体验",
  "version": "1.0.3",
  "author": "wildalley",
  "url": "https://github.com/wildalley/komari-theme-btop",
  "preview": "preview.png",
  "configuration": {
    "type": "managed",
    "name": "btop++ 终端主题设置",
    "data": [
      {
        "name": "基础外观设置",
        "type": "title"
      },
      {
        "key": "defaultColorMode",
        "name": "默认色彩模式",
        "type": "select",
        "default": "dark",
        "options": "dark,light",
        "help": "dark: 经典黑紫极客终端; light: 复古截图高亮浅色终端"
      },
      {
        "key": "refreshInterval",
        "name": "数据刷新周期",
        "type": "number",
        "default": 2,
        "help": "监控数据更新频率（秒），推荐 1-3 秒"
      }
    ]
  }
}
