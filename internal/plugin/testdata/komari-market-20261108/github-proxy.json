{
  "name": {
    "zh_CN": "GitHub 代理加速",
    "en": "GitHub Proxy"
  },
  "short": "github-proxy",
  "description": {
    "zh_CN": "为插件市场和主题市场的 GitHub 下载链接添加代理前缀，加速下载",
    "en": "Add proxy prefix to GitHub download URLs in plugin/theme market"
  },
  "version": "1.3.3",
  "author": "komari",
  "komari": ">=1.0.0",
  "entry": "script.js",
  "permissions": {
    "allowHooks": true,
    "allowRoutes": true,
    "node": true,
    "maxHTTPBodyBytes": 134217728,
    "timeout": 120
  },
  "configuration": {
    "type": "managed",
    "data": [
      {
        "key": "proxy_prefix",
        "name": {
          "zh_CN": "代理前缀",
          "en": "Proxy Prefix"
        },
        "type": "string",
        "default": "",
        "help": {
          "zh_CN": "添加到 GitHub URL 前的前缀，例如 https://ghproxy.com/",
          "en": "Prefix to prepend to GitHub URLs, e.g. https://ghproxy.com/"
        }
      },
      {
        "key": "server_url",
        "name": {
          "zh_CN": "服务器内部地址",
          "en": "Server Internal URL"
        },
        "type": "string",
        "default": "",
        "help": {
          "zh_CN": "用于内部自请求的地址，例如 http://127.0.0.1:25774。留空则从 Host 头自动检测。",
          "en": "Internal server URL for self-requests, e.g. http://127.0.0.1:25774. Leave empty to auto-detect from Host header."
        }
      },
      {
        "key": "enabled_plugins",
        "name": {
          "zh_CN": "启用插件市场代理",
          "en": "Enable Plugin Market Proxy"
        },
        "type": "switch",
        "default": true
      },
      {
        "key": "enabled_themes",
        "name": {
          "zh_CN": "启用主题市场代理",
          "en": "Enable Theme Market Proxy"
        },
        "type": "switch",
        "default": true
      }
    ]
  }
}
