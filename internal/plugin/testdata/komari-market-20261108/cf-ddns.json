{
  "$schema": "./node_modules/@komari-monitor/plugin-sdk/schema/komari-plugin.schema.json",
  "name": {
    "zh_CN": "Komari DDNS",
    "en": "Komari DDNS"
  },
  "short": "cf-ddns",
  "description": {
    "zh_CN": "根据 Komari 节点上报的公网 IP，自动更新 Cloudflare DNS 解析记录，实现动态域名解析。",
    "en": "Automatically update Cloudflare DNS records from the public IP reported by a Komari node, providing dynamic DNS."
  },
  "author": "穿云箭",
  "version": "0.1.3",
  "komari": ">=1.4.0",
  "entry": "script.js",
  "permissions": {
    "node": true,
    "allowSystemRPC": true,
    "allowRoutes": true,
    "maxHTTPBodyBytes": 65536,
    "timeout": 30
  },
  "configuration": {
    "type": "managed",
    "data": [
      {
        "key": "api_token",
        "name": { "zh_CN": "Cloudflare API Token", "en": "Cloudflare API Token" },
        "type": "string",
        "required": true,
        "help": {
          "zh_CN": "需具备 Zone:DNS:Edit 权限的全局 Cloudflare API Token，所有记录共用该 Token",
          "en": "Global Cloudflare API Token with Zone:DNS:Edit permission, shared by all records."
        }
      },
      {
        "key": "interval",
        "name": { "zh_CN": "检查间隔 (分钟)", "en": "Check Interval (minutes)" },
        "type": "number",
        "default": 5,
        "required": true
      },
      {
        "key": "notify",
        "name": { "zh_CN": "更新时发送通知", "en": "Notify on update" },
        "type": "switch",
        "default": false
      }
    ]
  },
  "pages": [
    {
      "file": "admin.html",
      "title": { "zh_CN": "DDNS 状态", "en": "DDNS Status" },
      "visibility": "admin"
    }
  ]
}
