# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
__debug*

# local development data
komari.db
/data
/utils/geoip/data
.vscode/
/backup

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# build
komari
/dist/
.codex

/web/filemanager/data
# --- Nekomari monorepo additions ---
# Any node_modules, at any depth. This started as /frontend/node_modules/ only, which
# is exactly how 183 files and 17.7 MB of deploy/node_modules got committed: the
# deploy/ browser checks have their own package.json, and a `git add -A` walked
# straight past a rule that named one directory.
node_modules/

# frontend (was komari-web, vendored into frontend/)
/frontend/dist/
/frontend/.vite/

# agent (was komari-agent, vendored into agent/)
/agent/nekomari-agent
/agent/nekomari-agent.exe
# A rebuilt agent kept as a side-by-side backup. The *.exe rule above does not
# catch it because of the trailing .old, which is how a 16 MB stale binary ended
# up tracked in the first place.
/agent/.*.exe.old
/agent/*.old

# server binary (root of repo)
/nekomari
/tools/zstdpack/zstdpack
/tools/zstdpack/zstdpack.exe

# local test artifacts
*.db
*.db-journal

# local run artifacts
/.runtest/

# The standalone SLA report's own build output (folded into dist/standalone/).
/frontend/dist-standalone/

# A checkout of the LuminaPlus theme, kept beside the panel for the same reason .runtest is: it is
# a separate repository with its own history, and a nested working tree inside this one turns the
# panel's git status into a list of someone else's files -- with a real risk of committing the
# whole theme into the panel by accident.
/theme-luminaplus/

# Raw evidence from the accuracy smoke runs: release binaries, machine reports and databases.
# README.md states the rule this encodes -- the scripts, the write-up and the redacted final
# report are committed, the raw machine output is not. It was left untracked for that reason,
# which cost 1271 lines in every `git status`; ignoring it keeps the evidence local and the
# status readable at the same time.
/.accuracy-smoke/

# Python bytecode from the audit scripts (docs/audits/**/*.py).
__pycache__/
*.pyc
